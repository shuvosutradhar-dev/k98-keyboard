<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PC Power K98"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="RGB Mechanical Keyboard for Android"
            android:textColor="#00D2FF"
            android:textSize="14sp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="#1E2024"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ধাপ ১: কীবোর্ড চালু করুন"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ফোনের সেটিংসে গিয়ে K98 Mechanical Keyboard সক্রিয় করুন।"
                android:textColor="#A0A5B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_enable_keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FF7043"
                android:text="১. কীবোর্ড সক্রিয় করুন (Enable)"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E2024"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ধাপ ২: কীবোর্ড নির্বাচন করুন"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="বর্তমান কীবোর্ড হিসেবে K98 সিলেক্ট করুন।"
                android:textColor="#A0A5B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_select_keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#00D2FF"
                android:text="২. কীবোর্ড নির্বাচন করুন (Switch)"
                android:textColor="#121316"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Test typing box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1E2024"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="টাইপিং টেস্ট ফিল্ড (Test Here):"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_test_typing"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="10dp"
                android:background="#2B2D31"
                android:gravity="top|start"
                android:hint="এখানে ক্লিক করে ব্লু সুইচ সাউন্ড ও টাইপিং পরীক্ষা করুন..."
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6E7380"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
